DEFAULT_SERVICE=gmok-back
DEFAULT_ENVIRONMENT=dev
OUTPUT_INDEX_PREFIX=gmok-back-logs

# PostgreSQL polling
# DATABASE_URL=postgresql://username:password@host:5432/database
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=require
ERROR_LOG_POLL_LIMIT=500
ERROR_LOG_CHECKPOINT=.state/error_log_checkpoint.json

# Optional OpenSearch push
OPENSEARCH_BULK_URL=
OPENSEARCH_SEARCH_URL=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# Optional instance metadata for DB error events
INSTANCE_ID=
INSTANCE_NAME=

# Discord alert evaluation
DISCORD_WEBHOOK_URL=
DASHBOARD_URL=
DASHBOARD_DATA_VIEW_ID=gmok-back-logs-pattern
ALERT_WINDOW_MINUTES=5
ALERT_COOLDOWN_MINUTES=5
ALERT_5XX_THRESHOLD=5
ALERT_REPEATED_ERROR_THRESHOLD=3
ALERT_P95_LATENCY_MS=1000
ALERT_DB_ERROR_THRESHOLD=5
ALERT_AUTH_FAILURE_THRESHOLD=20
ALERT_DEPENDENCY_ERROR_THRESHOLD=1
ALERT_PIPELINE_SILENT_MINUTES=10
ALERT_EXPECT_TRAFFIC=false
