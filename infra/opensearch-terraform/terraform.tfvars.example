region               = "eu-central-1"
domain_name          = "gmok-log-search"
engine_version       = "OpenSearch_2.13"
environment          = "dev"
instance_type        = "t3.small.search"
instance_count       = 1
ebs_volume_type      = "gp3"
ebs_volume_size      = 10
master_user_name     = "gmok_admin"
master_user_password = "REPLACE_WITH_STRONG_PASSWORD"

# Recommended: set this to your current public IP and EC2/Lambda egress CIDRs where possible.
# Example:
# allowed_source_ips = ["203.0.113.10/32"]
allowed_source_ips = []

# Lambda execution role or other IAM principals that should push/query logs.
allowed_principal_arns = []

tags = {
  Owner = "gmok-team"
}
